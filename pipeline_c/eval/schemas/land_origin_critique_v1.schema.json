{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mapgen:pipeline-c:eval:land-origin-critique-verdict:v1",
  "title": "Land-origin critique verdict v1",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["panel", "done_poorly", "done_well", "cannot_identify"],
    "properties": {
      "panel": {
        "type": "integer",
        "minimum": 1
      },
      "done_poorly": {
        "type": "array",
        "maxItems": 5,
        "items": {"$ref": "#/$defs/poor_claim"}
      },
      "done_well": {
        "type": "array",
        "maxItems": 5,
        "items": {"$ref": "#/$defs/claim"}
      },
      "cannot_identify": {
        "type": "array",
        "maxItems": 3,
        "items": {"$ref": "#/$defs/claim"}
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what", "where", "evidence"],
      "properties": {
        "what": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "where": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "evidence": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "poor_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what", "where", "evidence", "severity"],
      "properties": {
        "what": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "where": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "evidence": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "severity": {"enum": ["A", "B", "C", "D"]}
      }
    }
  }
}
