{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mapgen:pipeline-c:eval:layer-audit-verdict:v1",
  "title": "Single-image layer audit verdict v1",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "panel",
      "verdict",
      "generating_rule",
      "off_frame_prediction",
      "mechanism",
      "regularities"
    ],
    "properties": {
      "panel": {"type": "integer", "minimum": 1},
      "verdict": {"enum": ["process", "formula", "undecided"]},
      "generating_rule": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "closure"],
        "properties": {
          "description": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "closure": {"enum": ["closed", "partial", "open"]}
        }
      },
      "off_frame_prediction": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predictable", "prediction", "period_px", "orientation_deg"],
        "properties": {
          "predictable": {"type": "boolean"},
          "prediction": {
            "type": ["string", "null"], "minLength": 1, "pattern": "\\S"
          },
          "period_px": {"type": ["integer", "null"], "minimum": 2},
          "orientation_deg": {
            "type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 180
          }
        }
      },
      "mechanism": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "confidence", "evidence"],
        "properties": {
          "label": {"$ref": "#/$defs/mechanism_label"},
          "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
          "evidence": {"type": "string", "minLength": 1, "pattern": "\\S"}
        }
      },
      "regularities": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["what", "where", "evidence", "kind"],
          "properties": {
            "what": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "where": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "evidence": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "kind": {"$ref": "#/$defs/regularity_kind"}
          }
        }
      }
    }
  },
  "$defs": {
    "mechanism_label": {
      "enum": [
        "periodic_waves",
        "distance_or_cost_field",
        "filtered_noise",
        "iterative_growth",
        "thresholded_field",
        "cannot_determine"
      ]
    },
    "regularity_kind": {
      "enum": [
        "grid_locking",
        "periodicity",
        "constant_scale",
        "constant_curvature",
        "symmetry",
        "straight_runs",
        "degenerate_morphology",
        "seams"
      ]
    }
  }
}
