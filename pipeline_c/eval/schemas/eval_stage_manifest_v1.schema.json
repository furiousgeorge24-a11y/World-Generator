{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mapgen:pipeline-c:eval:stage-manifest:v1",
  "title": "Pipeline C immutable evaluation stage manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "stage",
    "stage_id",
    "created_at_utc",
    "parent_manifest_sha256s",
    "prompt_ids",
    "schema_ids",
    "judge_visible_roots",
    "hidden_roots",
    "files"
  ],
  "properties": {
    "schema_id": {
      "const": "urn:mapgen:pipeline-c:eval:stage-manifest:v1"
    },
    "schema_version": {
      "const": 1
    },
    "stage": {
      "enum": ["bundle", "submission", "result"]
    },
    "stage_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "parent_manifest_sha256s": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "prompt_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schema_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "judge_visible_roots": {
      "$ref": "#/$defs/roots"
    },
    "hidden_roots": {
      "$ref": "#/$defs/roots"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "bundle"
          }
        }
      },
      "then": {
        "properties": {
          "parent_manifest_sha256s": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "submission"
          }
        }
      },
      "then": {
        "properties": {
          "parent_manifest_sha256s": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "result"
          }
        }
      },
      "then": {
        "properties": {
          "parent_manifest_sha256s": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "roots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\).+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
