{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mapgen:pipeline-c:eval:land-controls-sweep-verdict:v1",
  "title": "Land-control sweep verdict v1",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "panel",
      "target_continuity",
      "fragmentation_response",
      "land_amount_leakage",
      "naturalness"
    ],
    "properties": {
      "panel": {
        "type": "integer",
        "minimum": 1
      },
      "target_continuity": {"$ref": "#/$defs/assessment"},
      "fragmentation_response": {"$ref": "#/$defs/assessment"},
      "land_amount_leakage": {"$ref": "#/$defs/assessment"},
      "naturalness": {"$ref": "#/$defs/assessment"}
    }
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment", "where", "evidence"],
      "properties": {
        "assessment": {
          "enum": ["supports", "concern", "cannot_assess"]
        },
        "where": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
