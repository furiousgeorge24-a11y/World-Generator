{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mapgen:pipeline-c:eval:panel-key:v1",
  "title": "Pipeline C hidden perceptual panel key v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "prompt_id", "panels"],
  "properties": {
    "schema_id": {
      "const": "urn:mapgen:pipeline-c:eval:panel-key:v1"
    },
    "schema_version": {
      "const": 1
    },
    "prompt_id": {
      "enum": ["land_origin_critique_v1", "land_controls_sweep_v1"]
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "panel",
          "hidden_kind",
          "source_id",
          "duplicate_group",
          "stimulus_sha256"
        ],
        "properties": {
          "panel": {
            "type": "integer",
            "minimum": 1
          },
          "hidden_kind": {
            "enum": ["candidate", "reference"]
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "duplicate_group": {
            "type": ["string", "null"],
            "minLength": 1,
            "pattern": "\\S"
          },
          "stimulus_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
